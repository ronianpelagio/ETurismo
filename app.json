{
  "expo": {
    "name": "ETurismo",
    "slug": "eTURISMO",
    "version": "1.0.0",
    "owner": "eturismo",
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": false,
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "com.ronian.eturismo",
    "ios": {
      "bundleIdentifier": "com.ronian.eturismo",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes on artifacts.",
        "NSMicrophoneUsageDescription": "This app uses the microphone to record audio.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photos to set a profile picture.",
        "NSLocationWhenInUseUsageDescription": "Allow $(PRODUCT_NAME) to access your location to show directions to the museum.",
        "NSLocationAlwaysUsageDescription": "Allow $(PRODUCT_NAME) to access your location to show directions to the museum.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.ronian.eturismo",
      "softwareKeyboardLayoutMode": "resize",
      "config": {}
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sharing",
        {
          "ios": {
            "isDocumentPickerEnabled": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": true,
          "hidden": false,
          "style": "light"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-video",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan artifact QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to set a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/icon.png",
          "color": "#C9A84C",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "ETurismo"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to show directions to the museum.",
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to show directions to the museum."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": true,
        "style": "light",
        "hidden": false
      },
      "eas": {
        "projectId": "7ad28631-d37f-49a4-b663-7ad52d5cdde8"
      }
    }
  }
}
