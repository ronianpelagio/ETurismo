{
  "name": "etorismo",
  "license": "0BSD",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "index.js",
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "scripts": {
    "postinstall": "patch-package && node scripts/clean-generated-native.js",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "check": "npm run typecheck && npm run test && npm --prefix admin run typecheck && npm --prefix admin run lint && npm --prefix admin run build"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@react-navigation/bottom-tabs": "^7.3.14",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.3.21",
    "@supabase/supabase-js": "^2.49.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-auth-session": "~58.0.18",
    "expo-blur": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-location": "~58.0.22",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-video": "~58.0.14",
    "expo-web-browser": "~58.0.8",
    "lamejs": "^1.2.1",
    "nativewind": "^4.2.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-maps": "1.29.11",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "^4.7.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.13.1",
    "uuid": "^14.0.2"
